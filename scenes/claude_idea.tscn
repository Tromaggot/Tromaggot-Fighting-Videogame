[sub_resource type="GDScript" id="GDScript_uwrxv"]
script/source = "extends CharacterBody2D
# Bewegungskonstanten
const WALK_SPEED: float = 200.0
const RUN_SPEED: float = 400.0
const CRAWL_SPEED: float = 80.0
const JUMP_VELOCITY: float = -450.0
const DIAGONAL_JUMP_VELOCITY_X: float = 250.0
const GRAVITY: float = 980.0



# State-Machine
@onready var state_machine: StateMachine = StateMachine.new()
# Zustände
enum State {
	IDLE,
	WALK,
	RUN,
	DUCK,
	CRAWL,
	BLOCK,
	JUMP,
	FALL
}
# Aktuelle Eigenschaften
var facing_direction: int = 1  # 1 = rechts, -1 = links
var mouth_open: bool = false
var is_blocking: bool = false
# Sprite-Referenz (AnimatedSprite2D oder eigene Logik)
@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
func _ready() -> void:
	add_child(state_machine)
	
	# States registrieren
	for s in State.values():
		state_machine.add_state(State.keys()[s])
	
	state_machine.change_state(\"IDLE\")
 #   state_machine.state_changed.connect(_on_state_changed)
func _physics_process(delta: float) -> void:
	# Inputs sammeln
	var input_left: bool = Input.is_action_pressed(\"left\")
	var input_right: bool = Input.is_action_pressed(\"right\")
	var input_down: bool = Input.is_action_pressed(\"down\")
	var input_up: bool = Input.is_action_just_pressed(\"up\")
	var fire_pressed: bool = Input.is_action_pressed(\"fire\")
	
	var horizontal_input: int = int(input_right) - int(input_left)
	
	# Gravitation anwenden
	if not is_on_floor():
		velocity.y += GRAVITY * delta
	
	# State-Logik
	match state_machine.current_state:
		\"IDLE\":
			_handle_idle(horizontal_input, input_down, input_up, fire_pressed)
		
		\"WALK\":
			_handle_walk(horizontal_input, input_down, input_up, fire_pressed)
		
		\"RUN\":
			_handle_run(horizontal_input, input_down, input_up, fire_pressed)
		
		\"DUCK\":
			_handle_duck(horizontal_input, input_down, input_up, fire_pressed)
		
		\"CRAWL\":
			_handle_crawl(horizontal_input, input_down, fire_pressed)
		
		\"BLOCK\":
			_handle_block(input_down, fire_pressed)
		
		\"JUMP\", \"FALL\":
			_handle_air(horizontal_input, fire_pressed)
	
	# Mund-Logik (außer Block)
	if not is_blocking:
		_update_mouth(fire_pressed)
	
	move_and_slide()
	_update_animations()
# ============================================
# STATE HANDLERS
# ============================================
func _handle_idle(h_input: int, down: bool, up: bool, fire: bool) -> void:
	velocity.x = 0
	
	if up:
		_perform_jump(h_input)
	elif down:
		if fire:
			_enter_block()
		else:
			state_machine.change_state(\"DUCK\")
	elif h_input != 0:
		if fire:
			state_machine.change_state(\"RUN\")
		else:
			state_machine.change_state(\"WALK\")
		facing_direction = h_input
func _handle_walk(h_input: int, down: bool, up: bool, fire: bool) -> void:
	if h_input == 0:
		state_machine.change_state(\"IDLE\")
		velocity.x = 0
		return
	
	if up:
		_perform_jump(h_input)
		return
	
	if down:
		if fire:
			_enter_block()
		else:
			state_machine.change_state(\"DUCK\")
		return
	
	if fire:
		state_machine.change_state(\"RUN\")
		return
	
	facing_direction = h_input
	velocity.x = h_input * WALK_SPEED
func _handle_run(h_input: int, down: bool, up: bool, fire: bool) -> void:
	# Rennen: Fire + Richtung = schneller + Mund offen
	if not fire or h_input == 0:
		if h_input != 0:
			state_machine.change_state(\"WALK\")
		else:
			state_machine.change_state(\"IDLE\")
		return
	
	if up:
		_perform_jump(h_input)
		return
	
	if down:
		_enter_block()
		return
	
	facing_direction = h_input
	velocity.x = h_input * RUN_SPEED
func _handle_duck(h_input: int, down: bool, up: bool, fire: bool) -> void:
	# Ducken: keine horizontale Bewegung
	velocity.x = 0
	
	if not down:
		state_machine.change_state(\"IDLE\")
		return
	
	if fire:
		_enter_block()
		return
	
	# Kriechen bei Richtungseingabe
	if h_input != 0:
		state_machine.change_state(\"CRAWL\")
		facing_direction = h_input
func _handle_crawl(h_input: int, down: bool, fire: bool) -> void:
	if not down:
		state_machine.change_state(\"IDLE\")
		return
	
	if fire:
		_enter_block()
		return
	
	if h_input == 0:
		state_machine.change_state(\"DUCK\")
		velocity.x = 0
		return
	
	facing_direction = h_input
	velocity.x = h_input * CRAWL_SPEED
func _handle_block(down: bool, fire: bool) -> void:
	# Blocken: keine Bewegung möglich
	velocity.x = 0
	is_blocking = true
	mouth_open = false  # Mund bleibt beim Blocken zu
	
	if not down or not fire:
		is_blocking = false
		if down:
			state_machine.change_state(\"DUCK\")
		else:
			state_machine.change_state(\"IDLE\")
func _handle_air(h_input: int, fire: bool) -> void:
	# In der Luft: horizontale Steuerung beibehalten
	# (optional: Air-Control hinzufügen)
	
	if is_on_floor():
		if h_input != 0:
			state_machine.change_state(\"WALK\")
		else:
			state_machine.change_state(\"IDLE\")
		return
	
	# Fallend vs. steigend
	if velocity.y > 0 and state_machine.current_state != \"FALL\":
		state_machine.change_state(\"FALL\")
# ============================================
# HILFSFUNKTIONEN
# ============================================
func _perform_jump(h_input: int) -> void:
	velocity.y = JUMP_VELOCITY
	
	if h_input != 0:
		# Diagonaler Sprung
		velocity.x = h_input * DIAGONAL_JUMP_VELOCITY_X
		facing_direction = h_input
	else:
		# Senkrechter Sprung
		velocity.x = 0
	
	state_machine.change_state(\"JUMP\")
func _enter_block() -> void:
	state_machine.change_state(\"BLOCK\")
	is_blocking = true
	mouth_open = false
	velocity.x = 0
func _update_mouth(fire_pressed: bool) -> void:
	# Mund offen wenn Fire gedrückt (außer bei Block/Duck)
	var can_open_mouth: bool = not state_machine.is_state(\"BLOCK\") \\
							   and not state_machine.is_state(\"DUCK\") \\
							   and not state_machine.is_state(\"CRAWL\")
	
	if fire_pressed and can_open_mouth:
		mouth_open = true
	else:
		mouth_open = false
func _update_animations() -> void:
	# Sprite spiegeln basierend auf Blickrichtung
	sprite.flip_h = (facing_direction == -1)
	
	# Animation basierend auf State
	match state_machine.current_state:
		\"IDLE\":
			_play_anim(\"idle_mouth_open\" if mouth_open else \"idle\")
		\"WALK\":
			_play_anim(\"walk_mouth_open\" if mouth_open else \"walk\")
		\"RUN\":
			_play_anim(\"run_mouth_open\" if mouth_open else \"run\")
		\"DUCK\":
			_play_anim(\"duck\")
		\"CRAWL\":
			_play_anim(\"crawl\")
		\"BLOCK\":
			_play_anim(\"block\")
		\"JUMP\":
			_play_anim(\"jump_mouth_open\" if mouth_open else \"jump\")
		\"FALL\":
			_play_anim(\"fall_mouth_open\" if mouth_open else \"fall\")
func _play_anim(anim_name: String) -> void:
	if sprite.sprite_frames.has_animation(anim_name):
		if sprite.animation != anim_name:
			sprite.play(anim_name)
	else:
		# Fallback: ohne Mund-Variante
		var base_name = anim_name.replace(\"_mouth_open\", \"\")
		if sprite.animation != base_name:
			sprite.play(base_name)
"

